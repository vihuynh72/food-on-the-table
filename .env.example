# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.
# Anything prefixed with VITE_ is bundled into the browser build and is PUBLIC.

# --- Supabase (Project Settings → API) ---
# The anon/publishable key is meant to be public; Row Level Security is what protects your data.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# --- Google Maps Platform ---
# Browser key: restrict it by HTTP referrer and to Maps JavaScript, Places and Geocoding APIs.
VITE_GOOGLE_MAPS_API_KEY=your-browser-maps-key
# Server key for /api/place-details (Place Details lookups). Use a separate key, restricted to the Places API.
PLACE_DETAILS_API_KEY=your-server-places-key
# Optional override for the endpoint the client calls (defaults to /api/place-details)
# VITE_PLACE_DETAILS_ENDPOINT=

# --- OpenAI ---
# Do NOT put the OpenAI key here. It lives only in Supabase Edge Function secrets:
#   supabase secrets set OPENAI_API_KEY=sk-...
